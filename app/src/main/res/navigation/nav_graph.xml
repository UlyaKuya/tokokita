<?xml version="1.0" encoding="utf-8"?>

<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/todoFragment">

    <!-- ========================= -->
    <!-- PRODUK -->
    <!-- ========================= -->
    <fragment
        android:id="@+id/produkFragment"
        android:name="com.example.tokokita.ui.ProdukFragment"
        android:label="TokoKita"
        tools:layout="@layout/fragment_produk">

        <action
            android:id="@+id/action_produkFragment_to_detailFragment"
            app:destination="@id/detailFragment" />

        <action
            android:id="@+id/action_produkFragment_to_apiFragment"
            app:destination="@id/apiFragment" />

        <action
            android:id="@+id/action_produkFragment_to_todoFragment"
            app:destination="@id/todoFragment" />

    </fragment>


    <!-- ========================= -->
    <!-- DETAIL PRODUK -->
    <!-- ========================= -->
    <fragment
        android:id="@+id/detailFragment"
        android:name="com.example.tokokita.ui.DetailFragment"
        android:label="Detail Produk"
        tools:layout="@layout/fragment_detail">

        <argument
            android:name="productId"
            app:argType="integer" />

    </fragment>


    <!-- ========================= -->
    <!-- DATA API -->
    <!-- ========================= -->
    <fragment
        android:id="@+id/apiFragment"
        android:name="com.example.tokokita.ui.ApiFragment"
        android:label="Data API"
        tools:layout="@layout/fragment_api" />


    <!-- ========================= -->
    <!-- TO-DO LIST -->
    <!-- ========================= -->
    <fragment
        android:id="@+id/todoFragment"
        android:name="com.example.tokokita.ui.TodoFragment"
        android:label="To-Do List"
        tools:layout="@layout/fragment_todo" />

</navigation>